{
  "buildCommand": "npm run docs:build",
  "outputDirectory": ".vitepress/dist",
  "redirects": [
    {
      "source": "/zh/",
      "destination": "https://www.next-terminal.com/zh/docs/",
      "statusCode": 302
    },
    {
      "source": "/zh",
      "destination": "https://www.next-terminal.com/zh/docs/",
      "statusCode": 302
    },
    {
      "source": "/zh/*",
      "destination": "https://www.next-terminal.com/zh/docs/:splat",
      "statusCode": 302
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://www.next-terminal.com/sitemap.xml",
      "statusCode": 302
    },
    {
      "source": "/robots.txt",
      "destination": "https://www.next-terminal.com/robots.txt",
      "statusCode": 302
    },
    {
      "source": "/llms.txt",
      "destination": "https://www.next-terminal.com/llms.txt",
      "statusCode": 302
    },
    {
      "source": "/favicon.svg",
      "destination": "https://www.next-terminal.com/favicon.svg",
      "statusCode": 302
    },
    {
      "source": "/favicon.ico",
      "destination": "https://www.next-terminal.com/favicon.svg",
      "statusCode": 302
    },
    {
      "source": "/images/*",
      "destination": "https://www.next-terminal.com/images/:splat",
      "statusCode": 302
    },
    {
      "source": "/",
      "destination": "https://www.next-terminal.com/docs/",
      "statusCode": 302
    },
    {
      "source": "/*",
      "destination": "https://www.next-terminal.com/docs/:splat",
      "statusCode": 302
    }
  ]
}
